{
  "type": "function",
  "function": {
    "name": "list_resource_logs",
    "description": "List recent resource analytics logs for the current site. Supports inclusive dates, resource type, status, bot, protected, keyword, and pagination filters. Detail data comes from the bounded recent-resource ring.",
    "parameters": {
      "type": "object",
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Available values: all, image, css, javascript, file, system, or unknown."
        },
        "isBot": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Optional bot filter."
        },
        "isProtected": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Optional protected-resource filter."
        },
        "pageIndex": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Page index for pagination. Default 1."
        },
        "pageSize": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Page size for pagination. Default 20, maximum 200."
        },
        "keyword": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional case-insensitive search keyword."
        },
        "statusCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647,
          "description": "Optional exact HTTP status code."
        },
        "startDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inclusive analytics date in yyyy-MM-dd format. Defaults to Monday of the current analytics week."
        },
        "endDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "Inclusive analytics date in yyyy-MM-dd format. Defaults to the current analytics day."
        }
      },
      "additionalProperties": false
    }
  }
}
