{
  "type": "function",
  "function": {
    "name": "create_content_type",
    "description": "Create a ContentType. A corresponding ContentFolder with the same name will be created automatically",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "multipleLanguage": {
                "type": "boolean"
              },
              "isSummary": {
                "type": "boolean",
                "description": "Specifies whether this field should be displayed as a summary field when browsing data in table view"
              },
              "controlType": {
                "enum": [
                  "TextBox",
                  "TextArea",
                  "RichEditor",
                  "Selection",
                  "CheckBox",
                  "RadioBox",
                  "Switch",
                  "MediaFile",
                  "File",
                  "DateTime",
                  "Number",
                  "ColorPicker",
                  "KeyValues",
                  "ValueList"
                ]
              },
              "selectionOptions": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "controlType"
            ],
            "additionalProperties": false
          }
        },
        "sandbox": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sandbox name. Executes the operation in that sandbox site when provided."
        }
      },
      "required": [
        "name",
        "properties"
      ],
      "additionalProperties": false
    }
  }
}
