{
  "type": "function",
  "function": {
    "name": "save_service",
    "description": "Save reviewed complete services in the current server App Plan. Submit one or more same-type objects; reuse stable IDs for full replacement. Unsubmitted objects are retained, omitted optional fields in submitted objects are cleared. References must already exist or be included in this same-type batch. Empty arrays are a no-op. Requires an existing Blueprint. The entire batch is validated before one aggregate write; no runtime resources or progress are created.",
    "parameters": {
      "type": "object",
      "properties": {
        "services": {
          "type": [
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "sourceFileIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "scenarioIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "businessRuleIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "inputContractId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "outputContractId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "api": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "method",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "sandbox": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sandbox name. Executes the operation in that sandbox site when provided."
        }
      },
      "required": [
        "services"
      ],
      "additionalProperties": false
    }
  }
}
