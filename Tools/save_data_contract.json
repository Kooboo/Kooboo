{
  "type": "function",
  "function": {
    "name": "save_data_contract",
    "description": "Save reviewed complete contracts in the current server App Plan. Submit one or more same-type objects; reuse stable IDs for full replacement. Unsubmitted objects are retained, omitted optional fields in submitted objects are cleared. References must already exist or be included in this same-type batch. Empty arrays are a no-op. Requires an existing Blueprint. The entire batch is validated before one aggregate write; no runtime resources or progress are created.",
    "parameters": {
      "type": "object",
      "properties": {
        "dataContracts": {
          "type": [
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "type": {
                      "enum": [
                        "text",
                        "integer",
                        "decimal",
                        "boolean",
                        "date",
                        "datetime",
                        "object",
                        "text[]",
                        "integer[]",
                        "decimal[]",
                        "boolean[]",
                        "date[]",
                        "datetime[]",
                        "object[]"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "nullable": {
                      "type": "boolean"
                    },
                    "objectContractId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "businessField",
                              "stateDimension",
                              "state",
                              "fact",
                              "businessRule"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          }
                        },
                        "required": [
                          "type",
                          "id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "type",
                    "required",
                    "nullable"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "sandbox": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sandbox name. Executes the operation in that sandbox site when provided."
        }
      },
      "required": [
        "dataContracts"
      ],
      "additionalProperties": false
    }
  }
}
