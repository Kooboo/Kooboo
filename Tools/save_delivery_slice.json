{
  "type": "function",
  "function": {
    "name": "save_delivery_slice",
    "description": "Save reviewed complete slices in the current server App Plan. Submit one or more same-type objects; reuse stable IDs for full replacement. Unsubmitted objects are retained, omitted optional fields in submitted objects are cleared. References must already exist or be included in this same-type batch. Empty arrays are a no-op. Requires an existing Blueprint. The entire batch is validated before one aggregate write; no runtime resources or progress are created.",
    "parameters": {
      "type": "object",
      "properties": {
        "deliverySlices": {
          "type": [
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "goal": {
                "type": "string"
              },
              "scenarioIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "screenIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serviceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sourceFileIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "name",
              "goal"
            ],
            "additionalProperties": false
          }
        },
        "sandbox": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional sandbox name. Executes the operation in that sandbox site when provided."
        }
      },
      "required": [
        "deliverySlices"
      ],
      "additionalProperties": false
    }
  }
}
